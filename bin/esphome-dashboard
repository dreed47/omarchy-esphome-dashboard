#!/usr/bin/env node
// esphome-dashboard - the single engine behind the ESPHome Dashboard Omarchy
// plugin. Service.qml and Panel.qml both shell out to this; nothing mDNS- or
// network-related is done directly from QML. Pure parsing lives in
// ../deviceLogic.mjs, system calls in ../lib/io.mjs.

import {
    parseArgs, HELP, COMMANDS,
    parseEsphomeDevices, mergeHealth, deviceAlerts, worstSeverity, summaryLine,
} from "../deviceLogic.mjs"

import {
    parseUpdateEntities, mergeFirmwareUpdates, haConfigured, normalizeBaseUrl,
} from "../haLogic.mjs"

import * as io from "../lib/io.mjs"
import { readFileSync } from "node:fs"

function die(msg, code = 1) {
    process.stderr.write("esphome-dashboard: " + msg + "\n")
    process.exit(code)
}
function outJson(v) { process.stdout.write(JSON.stringify(v) + "\n") }

async function discover() {
    return parseEsphomeDevices(await io.avahiBrowseEsphome())
}

async function cmdDevices(a) {
    const devices = await discover()
    if (a.json) return outJson(devices)
    if (!devices.length) { console.log("(no ESPHome devices found)"); return }
    for (const d of devices) {
        console.log(d.friendlyName + "  " + d.address + "  " + d.platform + "/" + d.board + "  v" + d.espVersion)
    }
}

async function buildStatus(healthTimeoutMs) {
    const raw = await discover()
    const health = await io.healthCheckAll(raw, healthTimeoutMs)
    let devices = mergeHealth(raw, health).map((d) => ({ ...d, alerts: deviceAlerts(d), firmwareUpdate: null }))

    // Home Assistant integration is entirely optional and best-effort: no
    // saved token, or HA unreachable, just means no firmwareUpdate data -
    // it never fails the whole status call.
    let haConnected = false
    const haCfg = io.readHaConfig()
    if (haConfigured(haCfg)) {
        const r = await io.haGetStates(haCfg)
        if (r.ok && Array.isArray(r.body)) {
            haConnected = true
            devices = mergeFirmwareUpdates(devices, parseUpdateEntities(r.body))
        }
    }

    return {
        devices,
        deviceCount: devices.length,
        onlineCount: devices.filter((d) => d.online).length,
        worstState: worstSeverity(devices),
        summary: summaryLine(devices),
        haConnected,
    }
}

async function cmdStatus(a) {
    const timeout = parseInt(a.timeout, 10) || 1500
    const st = await buildStatus(timeout)
    if (a.json) return outJson(st)
    console.log(st.summary)
    for (const d of st.devices) {
        console.log("  " + (d.online ? "*" : " ") + " " + d.friendlyName + "  " + d.address
            + "  " + (d.online ? d.latencyMs + "ms" : "offline")
            + (d.alerts.length ? "  [" + d.alerts.map((x) => x.text).join(", ") + "]" : ""))
    }
}

async function cmdPing(a) {
    if (!a.host) die("ping: --host is required")
    const port = parseInt(a.port, 10) || 6053
    const timeout = parseInt(a.timeout, 10) || 1500
    const r = await io.tcpHealthCheck(a.host, port, timeout)
    if (a.json) return outJson(r)
    console.log(r.online ? "online (" + r.latencyMs + "ms)" : "offline")
}

// ---- Home Assistant integration (Phase 2, opt-in) ------------------

async function cmdHaToken(a) {
    if (!a["base-url"]) die("ha-token: --base-url is required")
    let raw = ""
    try { raw = readFileSync(0, "utf8") } catch { die("ha-token: could not read a token from stdin") }
    const token = raw.trim()
    if (!token) die("ha-token: no token on stdin (pipe it in: echo \"$TOKEN\" | esphome-dashboard ha-token ...)")

    const cfg = { baseUrl: normalizeBaseUrl(a["base-url"]), token, verifyTls: !!a["verify-tls"] }
    const r = await io.haWhoAmI(cfg)
    if (!r.ok) die("could not verify that token against " + cfg.baseUrl + ": " + (r.error || ("HTTP " + r.status)))

    io.writeHaConfig(cfg)
    const version = r.body && r.body.version ? " (Home Assistant " + r.body.version + ")" : ""
    console.log("saved " + io.haConfigPath() + version)
}

function cmdHaForget() {
    io.deleteHaConfig()
    console.log("Home Assistant token removed")
}

async function cmdHaStatus(a) {
    const cfg = io.readHaConfig()
    if (!haConfigured(cfg)) die("no Home Assistant token saved - run: ha-token --base-url <url>")
    const r = await io.haGetStates(cfg)
    if (!r.ok) die("Home Assistant request failed: " + (r.error || ("HTTP " + r.status)))
    const entities = parseUpdateEntities(r.body)
    if (a.json) return outJson(entities)
    if (!entities.length) { console.log("(no update.* entities)"); return }
    for (const e of entities) {
        console.log(e.entityId + "  " + (e.available ? e.installedVersion + " -> " + e.latestVersion : "up to date"))
    }
}

async function cmdUpdateInstall(a) {
    if (!a.entity) die("update-install: --entity is required (e.g. update.stairlights_firmware)")
    const cfg = io.readHaConfig()
    if (!haConfigured(cfg)) die("no Home Assistant token saved - run: ha-token --base-url <url>")
    const r = await io.haCallService(cfg, "update", "install", { entity_id: a.entity })
    if (!r.ok) die("install request failed: " + (r.error || ("HTTP " + r.status + " " + String(r.raw || "").slice(0, 300))))
    outJson({ requested: true, entity: a.entity })
}

async function main() {
    let a
    try {
        a = parseArgs(process.argv.slice(2))
    } catch (e) {
        die(String(e.message || e))
    }
    if (a.help || a.cmd === "" || a.cmd === "help") { process.stdout.write(HELP); return }
    if (!COMMANDS.includes(a.cmd)) die("unknown command: " + a.cmd + " (try --help)")

    switch (a.cmd) {
        case "status": return cmdStatus(a)
        case "devices": return cmdDevices(a)
        case "ping": return cmdPing(a)
        case "ha-token": return cmdHaToken(a)
        case "ha-forget": return cmdHaForget()
        case "ha-status": return cmdHaStatus(a)
        case "update-install": return cmdUpdateInstall(a)
    }
}

main().catch((e) => die(String((e && e.stack) || e), 1))
